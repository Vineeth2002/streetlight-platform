# ─── SERVER ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── DATABASE (Neon PostgreSQL recommended) ──────────────────────────────
DB_HOST=your-neon-host.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=10000
DB_SSL=true

# ─── SLA / BILLING ────────────────────────────────────────────────────────
SLA_RESOLUTION_HOURS=48
ENERGY_TARIFF_INR_PER_KWH=6.00
DEMURRAGE_RATE_INR_PER_POLE_PER_DAY=25
STREETLIGHT_BURN_HOURS_PER_DAY=11
BILLING_CRON_SCHEDULE=0 2 1 * *

# ─── EMAIL (Gmail SMTP example) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
REPORT_RECIPIENTS=official1@gvmc.gov.in,official2@gvmc.gov.in

# ─── DIAGNOSTIC ENGINE THRESHOLDS ─────────────────────────────────────────
DIAG_MIN_VOLTAGE=180
DIAG_MIN_CURRENT_DAY_BURN=0.05
DIAG_FLUCTUATION_THRESHOLD_PCT=15
DIAG_FLUCTUATION_WINDOW_SECONDS=60

# ─── MODBUS (CCMS hardware — mock in dev) ─────────────────────────────────
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502
MODBUS_UNIT_ID=1

# ─── LOGGING ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── RATE LIMITING ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500

# ─── CITY / PLATFORM CONFIG ────────────────────────────────────────────────
CITY_NAME=Visakhapatnam
TOTAL_POLES=200000

# ─── AUTH ─────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES=8h

# ─── PRODUCTION ONLY ──────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-app.onrender.com

SLA_SWEEP_CRON_SCHEDULE=0 * * * *